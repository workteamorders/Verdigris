# Example values only. Never put real values in the repository.

# Build-time, public (nothing here is secret):
NEXT_PUBLIC_CHAIN_ID=46630            # 4663 mainnet, 46630 testnet, 31337 local rehearsal
NEXT_PUBLIC_AUDIT_REPORT_URL=         # empty until an external audit exists; the site then says "No external audit yet"
NEXT_PUBLIC_SOURCE_URL=               # optional public repository link
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545   # local rehearsal only; leave unset in production (reads go through /api/rpc)

# Server-side, set in the Cloudflare Pages dashboard (Functions environment), never NEXT_PUBLIC:
# RPC_URL_46630=https://rpc.testnet.chain.robinhood.com
# RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
# ALLOWED_CONTRACTS=0x0000000000000000000000000000000000000000   # the deployed Disc contract address(es), comma-separated
# BLOCKED_COUNTRIES=                                              # optional ISO codes, comma-separated
