{
  "name": "verdigris-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/contrast.mjs",
    "check:tokens": "node scripts/token-check.mjs",
    "verify:styleguide": "pnpm typecheck && pnpm check:contrast && pnpm check:tokens && pnpm build",
    "check:parity": "tsx scripts/check-parity.mts",
    "gen:deployments": "node scripts/gen-deployments.mjs",
    "predev": "pnpm gen:deployments",
    "prebuild": "pnpm gen:deployments",
    "pretypecheck": "pnpm gen:deployments",
    "copy:check": "node scripts/copy-check.mjs",
    "verify:deployment": "tsx scripts/verify-deployment.mts"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tanstack/react-query": "^5.107.1",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.17",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
